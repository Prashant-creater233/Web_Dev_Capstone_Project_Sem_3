PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/campus_library

# Use long random strings in real projects
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
ACCESS_EXPIRES=15m
REFRESH_EXPIRES=7d

# Frontend URL (used for CORS)
CLIENT_URL=http://localhost:5173

# Library rules
LOAN_DAYS=14
FINE_PER_DAY=5
MAX_BOOKS_PER_STUDENT=3

# The ONLY admin account. Created automatically when the server starts.
# Only these credentials can log in as admin. Change them before you submit or deploy.
ADMIN_NAME=Library Admin
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=Admin@123
