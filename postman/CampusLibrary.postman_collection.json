{
  "info": {
    "name": "CampusLibrary API",
    "description": "Run the folders from top to bottom, one request at a time.\n\nBefore you start: set the collection variables adminEmail and adminPassword to the ADMIN_EMAIL and ADMIN_PASSWORD from backend/.env.\n\nThe Login requests save the token, so the requests below a login run as that user. Roles: admin (from .env), librarian (created by the admin), student (registers).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "adminEmail",
      "value": "admin@campus.edu"
    },
    {
      "key": "adminPassword",
      "value": "Admin@123"
    },
    {
      "key": "librarianEmail",
      "value": "librarian1@campus.edu"
    },
    {
      "key": "librarianPassword",
      "value": "Librarian@123"
    },
    {
      "key": "studentEmail",
      "value": "student1@campus.edu"
    },
    {
      "key": "studentPassword",
      "value": "Student@123"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "bookId",
      "value": ""
    },
    {
      "key": "issueId",
      "value": ""
    },
    {
      "key": "librarianId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Admin and accounts",
      "item": [
        {
          "name": "Login as admin (from .env)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', d.accessToken);",
                  "pm.collectionVariables.set('refreshToken', d.refreshToken);",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Admin creates a librarian",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set('librarianId', d.user.id);",
                  "pm.test('status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Meera Librarian\",\n  \"email\": \"{{librarianEmail}}\",\n  \"password\": \"{{librarianPassword}}\",\n  \"role\": \"librarian\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          }
        },
        {
          "name": "Admin cannot create another admin (400)",
          "event": [
            {
              "listen": "test",
